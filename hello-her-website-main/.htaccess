RewriteEngine On

# Redirect direct client requests for *.html to extensionless URL (301)
# Matches the original request line to avoid redirect loops from internal rewrites
RewriteCond %{THE_REQUEST} \s/([^\s?]*)\.html[^\s]* [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve .html files for extensionless requests when the .html file exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*?)/?$ $1.html [L]
